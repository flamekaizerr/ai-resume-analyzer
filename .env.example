# Google AI Studio API key (get one free at https://aistudio.google.com/)
GOOGLE_API_KEY=your_key_here

# Gemini model name
GEMINI_MODEL=gemini-3.8-flash

# Optional, for python -m rag ask (OpenRouter). Without a key it returns the top passages instead
OPENROUTER_API_KEY=your-key-here
RAG_MODEL=openai/gpt-4o-mini
RAG_BASE_URL=https://openrouter.ai/api/v1
